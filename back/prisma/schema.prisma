// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "deno"
}

datasource db {
  provider = "postgresql"
}

model Secret {
  id        String     @id @default(uuid())
  name      String     @unique
  value     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  providers Provider[]
}

model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  host      String
  apiKey    Secret   @relation(fields: [apiKeyId], references: [id])
  apiKeyId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  llmCalls  LlmCall[]
}

enum LlmCallStatus {
  Ok
  Error
}

model LlmCall {
  id             String        @id @default(uuid())
  provider       Provider      @relation(fields: [providerId], references: [id])
  providerId     String
  model          String
  trigger        String
  conversationId String?
  parent         LlmCall?      @relation("LlmCallSteps", fields: [parentId], references: [id])
  parentId       String?
  steps          LlmCall[]     @relation("LlmCallSteps")
  status         LlmCallStatus
  finishReason   String?
  inputTokens    Int?
  outputTokens   Int?
  cachedTokens   Int?
  costUsd        Decimal?
  latencyMs      Int
  request        Json
  response       Json?
  error          String?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([createdAt])
}
