// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "deno"
}

datasource db {
  provider = "postgresql"
}

model Secret {
  id           String        @id @default(uuid())
  name         String        @unique
  value        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  providers    Provider[]
  mailAccounts MailAccount[]
}

model Provider {
  id        String    @id @default(uuid())
  name      String    @unique
  host      String
  apiKey    Secret    @relation(fields: [apiKeyId], references: [id])
  apiKeyId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  llmCalls  LlmCall[]
  agents    Agent[]
}

model Agent {
  id           String   @id @default(uuid())
  name         String   @unique
  model        String
  systemPrompt String
  provider     Provider @relation(fields: [providerId], references: [id])
  providerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum LlmCallStatus {
  Ok
  Error
}

model LlmCall {
  id             String        @id @default(uuid())
  provider       Provider      @relation(fields: [providerId], references: [id])
  providerId     String
  model          String
  trigger        String
  parent         LlmCall?      @relation("LlmCallSteps", fields: [parentId], references: [id])
  parentId       String?
  steps          LlmCall[]     @relation("LlmCallSteps")
  status         LlmCallStatus
  finishReason   String?
  inputTokens    Int?
  outputTokens   Int?
  cachedTokens   Int?
  costUsd        Decimal?
  latencyMs      Int
  request        Json
  response       Json?
  error          String?
  createdAt      DateTime      @default(now())
  messages       Message[]
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?

  @@index([conversationId])
  @@index([createdAt])
}

enum Platform {
  discord
}

model Conversation {
  id         String    @id @default(uuid())
  name       String
  platform   Platform?
  externalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  llmCalls   LlmCall[]
  messages   Message[]

  @@unique([platform, externalId])
}

enum MessageRole {
  user
  assistant
  system
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  // Set once the message has been appended to the conversation's Hindsight
  // document, so each turn only sends what is new
  retainedAt     DateTime?
  llmCall        LlmCall?     @relation(fields: [llmCallId], references: [id])
  llmCallId      String?
  toolCalls      ToolCall[]

  @@index([conversationId, createdAt])
}

model ToolCall {
  id        String          @id @default(uuid())
  apiId     String
  name      String
  arguments String
  result    String?
  createdAt DateTime        @default(now())
  messageId String
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  approval  ApprovalStatus?
  decidedAt DateTime?
}

enum ApprovalStatus {
  pending
  approved
  denied
}

model MailAccount {
  id         String       @id @default(uuid())
  name       String       @unique
  // The address the agent shows and replies from
  address    String       @unique
  imapHost   String
  imapPort   Int          @default(993)
  smtpHost   String
  smtpPort   Int          @default(587)
  username   String
  password   Secret       @relation(fields: [passwordId], references: [id])
  passwordId String
  enabled    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  folders    MailFolder[]
}

// Tracks how far each folder has been read. UIDs are only comparable while
// uidValidity stays the same; Dovecot changes it when it rewrites a mailbox.
model MailFolder {
  id          String      @id @default(uuid())
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  path        String
  uidValidity BigInt?
  lastUid     Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([accountId, path])
}
