{
  "tasks": {
    "dev": "deno run --watch --allow-all --env src/main.ts",
    "prisma": "deno run -A --env-file npm:prisma",
    "db:generate": "deno task prisma generate",
    "db:migrate": "deno task prisma migrate dev",
    "db:studio": "deno task prisma studio",
    "db:seed": "deno run -A --env-file prisma/seed.ts"
  },
  "imports": {
    "@openai/openai": "jsr:@openai/openai@^7.2.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.10.1",
    "@prisma/client": "npm:@prisma/client@^7.10.1",
    "@std/assert": "jsr:@std/assert@1",
    "@types/pg": "npm:@types/pg@^8.23.1",
    "pg": "npm:pg@^8.23.1",
    "prisma": "npm:prisma@^7.10.1",
    "zod": "npm:zod@^4.6.7",
    "@/": "./src/"
  }
}
