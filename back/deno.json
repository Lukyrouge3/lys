{
  "tasks": {
    "dev": "deno run --watch --allow-all --env src/main.ts",
    "prisma": "deno run -A --env-file npm:prisma",
    "db:generate": "deno task prisma generate",
    "db:migrate": "deno task prisma migrate dev",
    "db:studio": "deno task prisma studio",
    "db:seed": "deno run -A --env-file prisma/seed.ts",
    "test:db": "deno run -A --env-file=.env.test npm:prisma migrate deploy",
    "test": "deno test -A --env-file=.env.test tests/",
    "mail:check": "deno run -A --env src/mail/check.ts",
    "mail:watch": "deno run -A --env src/mail/watch.ts"
  },
  "imports": {
    "@openai/openai": "jsr:@openai/openai@^7.2.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.10.1",
    "@prisma/client": "npm:@prisma/client@^7.10.1",
    "@std/assert": "jsr:@std/assert@1",
    "@types/pg": "npm:@types/pg@^8.23.1",
    "@vectorize-io/hindsight-client": "npm:@vectorize-io/hindsight-client@^1.2.0",
    "discord.js": "npm:discord.js@^14.27.0",
    "ical.js": "npm:ical.js@^2.2.1",
    "imapflow": "npm:imapflow@^2.12.1",
    "pg": "npm:pg@^8.23.1",
    "prisma": "npm:prisma@^7.10.1",
    "tsdav": "npm:tsdav@^2.5.0",
    "webdav": "npm:webdav@^5.11.0",
    "zod": "npm:zod@^4.6.7",
    "@/": "./src/"
  }
}
