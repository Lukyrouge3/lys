{
  "manifest_version": 3,
  "name": "Send to Lys",
  "version": "0.1.0",
  "description": "Send the LinkedIn job you are viewing to your local Lys bot.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["protocol.js", "extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
